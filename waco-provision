#!/bin/bash

# Workstation as Code
# Copyright Nicola Musatti 2020 - 2026.

# waco-provision - install the waco_org.waco collection and apply it to this
# machine, with the settings in settings/type.yml and settings/machine.yml.
#
# Usage: ./waco-provision [-s source] [-n] [-- ansible-playbook options...]
#
#   -s  where the collection comes from:
#         a git ref of github.com/waco-org/waco (default: main; Galaxy
#         will be the default once the collection is published),
#         a git+URL[,ref] spec, a local checkout of the collection
#         (which waco must be able to read),
#         or "galaxy" (once the collection is published)
#   -n  install the collection and check the playbook, but don't run it
#
# It runs as the "waco" account that waco-bootstrap creates. Run from your
# own clone, it hands over with "sudo -iu waco waco-provision", which asks for
# your password. As waco it first refreshes waco's copy from the committed
# state of your clone (uncommitted changes are not applied), then installs the
# collection and its roles into .ansible/ in waco's copy and runs the playbook.

set -euo pipefail

root=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
source=main
dry=

if [ "$(id -un)" != waco ]; then
    waco_home=$(getent passwd waco | cut -d: -f6) || true
    if [ -z "$waco_home" ]; then
        echo "waco-provision: no waco account set up; run ./waco-bootstrap first" >&2
        exit 1
    fi
    echo "== Running as waco"
    exec sudo -iu waco "$waco_home/.local/bin/waco-provision" "$@"
fi

# Refresh this copy from the clone it was made from, then run the refreshed
# script. Your account makes the bundle, so git never runs as root or as waco
# on a repository waco doesn't own.
from=$(git -C "$root" config waco.source || true)
if [ -n "$from" ] && [ -z "${WACO_REFRESHED:-}" ]; then
    user=${from%%:*}
    path=${from#*:}
    bundle=$HOME/.cache/waco/settings.bundle
    mkdir -p "$(dirname "$bundle")"
    (cd / && sudo -u "$user" -H git -C "$path" bundle create - HEAD 2>/dev/null) > "$bundle"
    git -C "$root" fetch -q "$bundle" HEAD
    git -C "$root" -c advice.detachedHead=false checkout -qf --detach FETCH_HEAD
    echo "== Settings: $path ($user), $(git -C "$root" log -1 --format='%h %s')"
    if [ -n "$(cd / && sudo -u "$user" -H git -C "$path" status --porcelain)" ]; then
        echo "   Note: $path has uncommitted changes, which are not applied."
    fi
    WACO_REFRESHED=yes exec "$root/waco-provision" "$@"
fi

while getopts "s:nh" opt; do
    case $opt in
        s) source=$OPTARG ;;
        n) dry=yes ;;
        *) sed -n '6,17p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
    esac
done
shift $((OPTIND - 1))

export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
if command -v uv >/dev/null; then
    PATH="$(uv tool dir --bin):$PATH"
fi
if ! command -v ansible-playbook >/dev/null; then
    echo "waco-provision: ansible-playbook not found; run ./waco-bootstrap first" >&2
    exit 1
fi

export ANSIBLE_HOME="$root/.ansible"
export ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_HOME/collections"
export ANSIBLE_ROLES_PATH="$ANSIBLE_HOME/roles"

if [ "$source" = galaxy ]; then
    spec=waco_org.waco
elif [ -f "$source/galaxy.yml" ]; then
    spec=$(cd "$source" && pwd)
elif [[ $source == git+* ]]; then
    spec=$source
else
    spec="git+https://github.com/waco-org/waco.git,$source"
fi

echo "== Collection: $spec"
ansible-galaxy collection install --force "$spec"
ansible-galaxy role install --force \
    -r "$ANSIBLE_COLLECTIONS_PATH/ansible_collections/waco_org/waco/requirements.yml"
# What this machine's own tasks need, e.g. ansible.posix for mounts
if [ -f "$root/local/requirements.yml" ]; then
    ansible-galaxy install -r "$root/local/requirements.yml"
fi

# shellcheck disable=SC2054 # "localhost," is an inline inventory
playbook=(ansible-playbook -i localhost, "$root/provision.yml")
if [ -n "$dry" ]; then
    "${playbook[@]}" --syntax-check "$@"
    exit
fi
if [ "$(id -u)" -ne 0 ] && ! sudo -n true 2>/dev/null; then
    playbook+=(--ask-become-pass)
fi
"${playbook[@]}" "$@"
