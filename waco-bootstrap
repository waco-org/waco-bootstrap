#!/bin/bash

# Workstation as Code
# Copyright Nicola Musatti 2020 - 2026.

# waco-bootstrap - prepare this machine to run Waco: install git, uv and the
# packages Ansible needs, create the "waco" account that runs Waco, and give
# it ansible-core and its own copy of this clone.
#
# Usage: ./waco-bootstrap
#
# Run it as your own user, from your clone of waco-bootstrap (e.g. ~/.waco),
# not as root: it uses sudo where it must. Running it again is harmless.
#
# "waco" is a system account (home /var/lib/waco) with a locked password and
# passwordless sudo: it is reached only with "sudo -iu waco", which asks for
# your password. It keeps its own copy of your clone, refreshed from your
# committed state each time waco-provision runs, so only committed settings
# are applied and your account can't change waco's files.
#
# uv comes from the distro where it is packaged (Fedora, EPEL 10), otherwise
# from its GitHub release, checked against the release's SHA-256 and unpacked
# into /usr/local/bin. Waco's python role does the same, with the same version.

set -euo pipefail

ansible_core_version=2.22.0
uv_version=0.13.5

uv_package=
root=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
me=$(id -un)

if [ "$(id -u)" -eq 0 ]; then
    echo "waco-bootstrap: run it as your own user, not as root; it uses sudo where it must" >&2
    exit 1
fi
if [ "$(git -C "$root" rev-parse --is-shallow-repository 2>/dev/null)" = true ]; then
    echo "waco-bootstrap: $root is a shallow clone; run \"git -C $root fetch --unshallow\" first" >&2
    exit 1
fi

say() { printf '\n== %s\n' "$*"; }

# shellcheck source=/dev/null
. /etc/os-release
major=${VERSION_ID%%.*}
case " $ID ${ID_LIKE:-} " in
    *" ubuntu "* | *" debian "*) family=debian ;;
    *" fedora "* | *" rhel "*) family=redhat ;;
    *) echo "waco-bootstrap: unsupported distribution: $PRETTY_NAME" >&2; exit 1 ;;
esac

# The distro Python stays for the system side, so the packages Ansible's
# modules need on this machine are installed into it here: the dnf or apt
# bindings, and acl to run tasks as other users.
say "System packages"
if [ $family = debian ]; then
    export DEBIAN_FRONTEND=noninteractive
    sudo apt-get update -q
    sudo apt-get install -y -q acl ca-certificates curl git python3 python3-apt tar
    if apt-cache show uv >/dev/null 2>&1; then uv_package=yes; fi
else
    packages=(acl git python3 tar)
    if [ "$ID" = fedora ]; then
        packages+=(python3-libdnf5)
    elif ! rpm -q epel-release >/dev/null 2>&1; then
        # Rocky, Alma and CentOS Stream ship epel-release; RHEL doesn't.
        sudo dnf install -y -q epel-release ||
            sudo dnf install -y -q "https://dl.fedoraproject.org/pub/epel/epel-release-latest-$major.noarch.rpm"
    fi
    sudo dnf install -y -q "${packages[@]}"
    if dnf -q list uv >/dev/null 2>&1; then uv_package=yes; fi
fi

say "uv"
if command -v uv >/dev/null; then
    echo "Using $(command -v uv) ($(uv --version))"
elif [ -n "$uv_package" ]; then
    if [ $family = debian ]; then
        sudo apt-get install -y -q uv
    else
        sudo dnf install -y -q uv
    fi
else
    asset="uv-$(uname -m)-unknown-linux-gnu"
    url="https://github.com/astral-sh/uv/releases/download/$uv_version/$asset.tar.gz"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSL --retry 3 -o "$tmp/uv.tar.gz" "$url"
    sha256=$(curl -fsSL --retry 3 "$url.sha256" | cut -d' ' -f1)
    echo "$sha256  $tmp/uv.tar.gz" | sha256sum -c --quiet
    sudo tar -xzf "$tmp/uv.tar.gz" -C /usr/local/bin --strip-components=1 --no-same-owner
    echo "Installed /usr/local/bin/uv $uv_version"
fi
PATH=/usr/local/bin:$PATH

uv=$(command -v uv)

say "The waco account"
if ! getent passwd waco >/dev/null; then
    sudo useradd --system --create-home --home-dir /var/lib/waco --shell /bin/bash \
        --comment "Waco provisioning" waco
    echo "Created waco: $(getent passwd waco)"
else
    echo "Using the existing account: $(getent passwd waco)"
fi
case $(sudo getent shadow waco | cut -d: -f2) in
    '!'* | '*'*) ;;
    *) echo "Warning: waco's password is not locked; lock it with: sudo passwd -l waco" ;;
esac
waco_home=$(getent passwd waco | cut -d: -f6)

# waco runs Ansible, which uses sudo for the tasks that need root. Its
# password is locked, so sudo can't ask for one.
dropin=$(mktemp)
echo 'waco ALL=(ALL) NOPASSWD: ALL' > "$dropin"
sudo visudo -cqf "$dropin"
sudo install -m 0440 -o root -g root "$dropin" /etc/sudoers.d/waco
rm -f "$dropin"
echo "/etc/sudoers.d/waco: passwordless sudo"

# Run a command as waco, from its home: waco can't enter your clone.
as_waco() { (cd / && sudo -u waco -H "$@"); }

# ansible-core 2.22 needs Python 3.13 or later. Where the distro's is older
# (3.9 on EL9, 3.12 on EL10, 3.10 on Ubuntu 22.04) uv installs one. It's done
# explicitly because EPEL's uv sets python-downloads to manual.
say "ansible-core $ansible_core_version for waco"
if ! as_waco "$uv" python find --quiet '>=3.13' >/dev/null 2>&1; then
    as_waco "$uv" python install --no-bin 3.13
fi
as_waco "$uv" tool install --quiet --python '>=3.13' "ansible-core==$ansible_core_version"
as_waco "$waco_home/.local/bin/ansible" --version | head -1

# waco's copy: a repository of its own, which waco-provision refreshes from
# yours through a git bundle made by your account (waco uses sudo for that).
say "waco's copy of $root"
clone=$waco_home/waco-bootstrap
if ! as_waco test -d "$clone/.git"; then
    as_waco git init -q "$clone"
fi
as_waco git -C "$clone" config waco.source "$me:$root"
bundle=$waco_home/.cache/waco/settings.bundle
as_waco mkdir -p "$(dirname "$bundle")"
git -C "$root" bundle create - HEAD 2>/dev/null | as_waco tee "$bundle" >/dev/null
as_waco git -C "$clone" fetch -q "$bundle" HEAD
as_waco git -C "$clone" -c advice.detachedHead=false checkout -qf --detach FETCH_HEAD
as_waco git -C "$clone" log -1 --format='At %h %s'
as_waco mkdir -p "$waco_home/.local/bin"
as_waco ln -sfn "$clone/waco-provision" "$waco_home/.local/bin/waco-provision"

say "Done"
if [ -n "$(git -C "$root" status --porcelain)" ]; then
    echo "Note: $root has uncommitted changes; waco only uses what is committed."
fi
echo "Now edit settings/type.yml and settings/machine.yml in $root, commit them,"
echo "then run ./waco-provision (it runs as waco: sudo -iu waco waco-provision)."
